{
  "name": "@radix-solid/website",
  "version": "0.0.0-local",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr && node scripts/build-site.ts && node scripts/build-markdown.ts && node scripts/build-search-index.ts && node scripts/build-sandboxes.ts",
    "check:export": "node scripts/check-export.ts",
    "prepare:public-archives": "node scripts/prepare-public-rc4-archives.ts",
    "check:examples": "node scripts/check-examples.ts",
    "check:snippets": "node scripts/check-snippets.ts",
    "check:sandboxes": "node scripts/check-sandboxes.ts",
    "preview": "node scripts/serve.ts",
    "test": "node --test worker/*.test.ts scripts/*.test.ts"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@wsagency/radix2solid-charts": "workspace:*",
    "@wsagency/radix2solid-icons": "workspace:*",
    "@wsagency/radix2solid-icons-extra": "workspace:*",
    "@wsagency/radix2solid-primitives": "workspace:*",
    "@wsagency/radix2solid-themes": "workspace:*",
    "@radix-ui/colors": "3.0.0",
    "@solidjs/web": "2.0.0-rc.19",
    "bezier-easing": "2.1.0",
    "colorjs.io": "0.5.2",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-select": "6.0.4",
    "hast-util-to-html": "9.0.5",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "refractor": "3.6.0",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "solid-js": "2.0.0-rc.19",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@types/hast": "3.0.5",
    "@types/refractor": "3.4.1",
    "@vanilla-extract/css": "1.21.3",
    "vite": "8.3.3",
    "wrangler": "4.149.0"
  }
}
